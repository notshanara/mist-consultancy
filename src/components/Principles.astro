---
import { principles } from '../data/content';
---

<section id="principles" class="section-y bg-pale" aria-labelledby="principles-title">
  <div class="wrap">
    <h2 id="principles-title" class="mx-auto max-w-[20ch] text-center text-title" data-reveal>Three principles we work by.</h2>
    <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8 lg:mt-16" data-reveal-group>
      {
        principles.map((principle, i) => (
          <li class="border-t border-carbon pt-6" data-reveal>
            <p class="text-sm font-semibold text-navy">0{i + 1}</p>
            <h3 class="mt-3 max-w-[22ch] text-subheading">{principle.name}</h3>
            <p class="mt-3 max-w-[40ch] text-iron">{principle.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
