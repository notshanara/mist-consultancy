---
// Three outlines slide together as the section is scrolled, and resolve into one solid Mist mark.
interface Props {
  items: { name: string; text: string }[];
}
const { items } = Astro.props;
---

<div class="merge" data-scrub="through" data-scrub-from="0.85" data-scrub-to="0.75" aria-hidden="true">
  <svg viewBox="-114 -107 228 214" class="shape shape-a"><path d="M-13.9-106.4H113.7V9.7L12.3 106.4H-113.7V-12Z" /></svg>
  <svg viewBox="-114 -107 228 214" class="shape shape-b"><path d="M-13.9-106.4H113.7V9.7L12.3 106.4H-113.7V-12Z" /></svg>
  <svg viewBox="-114 -107 228 214" class="shape shape-c"><path d="M-13.9-106.4H113.7V9.7L12.3 106.4H-113.7V-12Z" /></svg>
</div>

<ul class="columns" data-reveal-group>
  {
    items.map((item) => (
      <li class="border-t border-carbon pt-5" data-reveal>
        <h3 class="text-subheading">{item.name}</h3>
        <p class="mt-3 max-w-[38ch]">{item.text}</p>
      </li>
    ))
  }
</ul>

<style>
  .merge {
    position: relative;
    height: clamp(7rem, 16vw, 12rem);
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .shape {
    --size: clamp(7rem, 16vw, 12rem);
    position: absolute;
    top: 0;
    left: calc(50% - var(--size) / 2);
    width: var(--size);
    height: var(--size);
    overflow: visible;
  }

  .shape path {
    fill: var(--color-carbon);
    fill-opacity: var(--p, 1);
    stroke: var(--color-carbon);
    stroke-width: 2.5;
  }

  /* Each outline starts over its column and meets the others in the middle. */
  .shape-a {
    transform: translateX(calc((1 - var(--p, 1)) * -33vw));
  }

  .shape-c {
    transform: translateX(calc((1 - var(--p, 1)) * 33vw));
  }

  .columns {
    display: grid;
    gap: 2.5rem 2rem;
  }

  @media (min-width: 768px) {
    .columns {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 767.98px) {
    .shape-a {
      transform: translateX(calc((1 - var(--p, 1)) * -28vw));
    }

    .shape-c {
      transform: translateX(calc((1 - var(--p, 1)) * 28vw));
    }
  }
</style>
