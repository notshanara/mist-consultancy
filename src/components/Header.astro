---
import Mark from './Mark.astro';
import { headerNav, moreNav, site } from '../data/site';

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHere = (href: string) => (href.replace(/\/$/, '') || '/') === here;
// A page within a section, such as one of the problem pages under Our Approach, marks its section's link.
const isWithin = (href: string) => href !== '/' && here.startsWith(href.replace(/\/$/, '') + '/');
const current = (href: string) => (isHere(href) ? 'page' : isWithin(href) ? 'true' : undefined);
const moreIsHere = moreNav.some((item) => isHere(item.href));
const chevron = 'M1 1.5l5 5 5-5';
---

<header class="site-header bg-carbon text-pale" data-site-header>
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="MIST Consultancy, home">
      <Mark class="block h-(--logo-h) w-auto" />
      <span>MIST Consultancy</span>
    </a>

    <nav aria-label="Main" class="nav">
      <ul class="primary">
        {
          headerNav.map((item) => (
            <li>
              <a href={item.href} class="item" aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <details class="more" data-more>
        <summary class:list={['item', { 'is-here': moreIsHere }]}>
          <span class="wide">More</span>
          <span class="narrow">Menu</span>
          <svg viewBox="0 0 12 8" width="12" height="8" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d={chevron} />
          </svg>
        </summary>
        <div class="panel">
          <ul>
            {
              headerNav.map((item) => (
                <li class="narrow">
                  <a href={item.href} aria-current={current(item.href)}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            {
              moreNav.map((item) => (
                <li>
                  <a href={item.href} aria-current={current(item.href)}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <ul class="reach">
            <li><a href={`mailto:${site.email.enquiries}`} class="break-words">{site.email.enquiries}</a></li>
            <li><a href={site.phone.href}>{site.phone.display}</a></li>
          </ul>
        </div>
      </details>
    </nav>
  </div>
</header>

<style>
  /* One bar, held at the top while the page scrolls. Its height is the --nav-h that pinned sections sit under. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--nav-h);
  }

  /* Laid out like the logo: the name's capitals stand as tall as the mark, with only the M's own spacing between
     them. Manrope's capitals are 0.72 of its size. Narrow phones shrink the whole lockup so Menu still fits. */
  .brand {
    --logo-h: min(1.125rem, calc((100vw - 8.5rem) / 13.5));
    display: inline-flex;
    align-items: baseline;
    color: var(--color-white);
    font-size: calc(var(--logo-h) / 0.72);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .primary {
    display: none;
    gap: 2rem;
  }

  .item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    transition: color 0.25s ease;
    cursor: pointer;
  }

  .item:hover,
  .item[aria-current],
  .more[open] .item {
    color: var(--color-white);
  }

  /* The current page is marked in blue. */
  .item::after {
    content: '';
    position: absolute;
    inset: auto 0 0.5rem;
    height: 1px;
    background: var(--color-blue);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease);
  }

  .item[aria-current]::after,
  .item.is-here::after {
    transform: scaleX(1);
  }

  summary {
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary svg {
    transition: transform 0.3s var(--ease);
  }

  .more[open] summary svg {
    transform: rotate(180deg);
  }

  .wide {
    display: none;
  }

  /* On a phone the panel spans the bar. Wider, it hangs from the More button. */
  .panel {
    position: absolute;
    inset: 100% 0 auto;
    padding: 1.25rem var(--gutter) 1.5rem;
    background: var(--color-gunmetal);
  }

  .panel ul + ul {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-iron);
  }

  .panel a {
    display: block;
    padding-block: 0.5rem;
    transition: color 0.25s ease;
  }

  .panel a:hover,
  .panel a[aria-current] {
    color: var(--color-white);
  }

  .reach {
    font-size: 0.9375rem;
  }

  :global(html.motion) .more[open] .panel {
    animation: drop 0.35s var(--ease);
  }

  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-0.375rem);
    }
  }

  @media (min-width: 768px) {
    .primary {
      display: flex;
    }

    .wide {
      display: inline;
    }

    .narrow {
      display: none;
    }

    .more {
      position: relative;
    }

    .panel {
      --cut: 0.75rem;
      inset: 100% 0 auto auto;
      min-width: 17rem;
      padding: 1rem 1.25rem 1.25rem;
      clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, 0 100%);
    }
  }
</style>

<script>
  // The menu is a native details element, so it works without this. These make it close when expected.
  const more = document.querySelector<HTMLDetailsElement>('[data-more]');
  const summary = more?.querySelector('summary');

  if (more && summary) {
    const close = () => {
      more.open = false;
    };

    document.addEventListener('click', (event) => {
      if (more.open && !more.contains(event.target as Node)) close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && more.open) {
        close();
        summary.focus();
      }
    });

    more.addEventListener('focusout', (event) => {
      if (more.open && event.relatedTarget && !more.contains(event.relatedTarget as Node)) close();
    });

    more.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
  }
</script>
