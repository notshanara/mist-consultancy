---
import Mark from './Mark.astro';
import { processStages } from '../data/content';

const bands = ['bg-gunmetal text-white', 'bg-iron text-white', 'bg-slate text-carbon'];
---

<section id="process" class="track" data-route aria-labelledby="process-title">
  <div class="stage">
    <div class="wrap">
      <h2 id="process-title" class="max-w-[20ch] text-title" data-reveal>From first conversation to review.</h2>
    </div>

    <div class="rail">
      <div class="route">
        {
          processStages.map((group, g) => (
            <>
              <section class:list={['group', `group-${g + 1}`, `n-${group.steps.length}`]} aria-label={`${group.stage} stage`}>
                <p class:list={['band', bands[g]]}>{group.stage}</p>
                <ol class="steps">
                  {group.steps.map((step) => (
                    <li class="step">
                      <span class="node">
                        <Mark class="block h-[1.625rem] w-7" />
                      </span>
                      <p class="text-sm font-medium text-iron">{step.number}</p>
                      <h3 class="mt-1 text-subheading">{step.name}</h3>
                      <p class="mt-3 text-iron">{step.text}</p>
                    </li>
                  ))}
                </ol>
              </section>
              {g === 0 && (
                <div class="decision">
                  <p class="font-semibold">Your decision</p>
                  <p class="mt-1 text-iron">
                    An assessment can end with the client report. Any further work is agreed as a separate scope, with objectives, responsibilities, deliverables, fees and acceptance criteria.
                  </p>
                </div>
              )}
            </>
          ))
        }

        <div class="scope">
          <p class="font-semibold">Scope</p>
          <p class="mt-1 text-iron">The exact scope, timescale and deliverables depend on your requirements.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .track {
    --band: 2.875rem;
    --node-y: 0.8125rem;
    padding-block: clamp(5rem, 3rem + 8vw, 10rem);
  }

  .rail {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-inline: var(--gutter);
    max-width: 86rem;
    margin-inline: auto;
  }

  .route {
    display: grid;
    row-gap: 2.5rem;
  }

  .band {
    display: flex;
    align-items: center;
    height: var(--band);
    padding-inline: 1rem;
    font-weight: 500;
  }

  .steps {
    position: relative;
    display: grid;
    row-gap: 2.5rem;
    margin-top: 2rem;
    padding-left: 3rem;
  }

  .steps::before {
    content: '';
    position: absolute;
    top: 0.5rem;
    bottom: 0;
    left: 0.875rem;
    width: 1px;
    background: var(--color-blue);
    transform: scaleY(var(--draw, 1));
    transform-origin: top;
  }

  .step {
    position: relative;
  }

  .node {
    position: absolute;
    top: 0;
    left: -3rem;
    display: block;
    padding-block: 0.25rem;
    background: var(--color-white);
    color: var(--color-navy);
    transition: color 0.4s ease;
  }

  :global(html.motion) .step:not(:global(.on)) .node {
    color: var(--color-pale);
  }

  .decision,
  .scope {
    max-width: 46ch;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .decision {
    padding: 1.25rem 0 1.25rem 1.25rem;
    border-left: 1px dashed var(--color-iron);
  }

  @media (min-width: 1024px) {
    .route {
      grid-template-columns: repeat(5, 1fr);
      row-gap: 0;
    }

    .group {
      grid-row: 1;
    }

    .group-1 {
      position: relative;
      grid-column: 1 / 3;
    }

    .group-2 {
      grid-column: 3 / 4;
    }

    .group-3 {
      grid-column: 4 / 6;
    }

    /* Together the three bands take the outline of the Mist mark. */
    .group-1 .band {
      clip-path: polygon(0.75rem 0, 100% 0, 100% 100%, 0 100%, 0 0.75rem);
    }

    .group-3 .band {
      clip-path: polygon(0 0, 100% 0, 100% calc(100% - 0.75rem), calc(100% - 0.75rem) 100%, 0 100%);
    }

    .steps {
      grid-template-columns: repeat(var(--n), 1fr);
      margin-top: 2.5rem;
      padding-left: 0;
    }

    .steps::before {
      top: var(--node-y);
      right: 0;
      bottom: auto;
      left: 0;
      width: auto;
      height: 1px;
      transform: scaleX(var(--draw, 1));
      transform-origin: left;
    }

    .group-3 .steps::after {
      content: '';
      position: absolute;
      top: calc(var(--node-y) - 4px);
      right: 1px;
      width: 9px;
      height: 9px;
      border-top: 1px solid var(--color-slate);
      border-right: 1px solid var(--color-slate);
      transform: rotate(45deg);
    }

    .step {
      padding-top: 3.5rem;
      padding-right: 1.75rem;
    }

    .node {
      top: 0;
      left: 0;
      padding-block: 0;
      padding-right: 0.75rem;
    }

    .group-1::after {
      content: '';
      position: absolute;
      top: var(--band);
      right: -1px;
      bottom: 0;
      border-right: 1px dashed var(--color-iron);
    }

    .group-1 .step:last-child {
      padding-right: 2.5rem;
    }

    .group-2 .step {
      padding-left: 1.25rem;
    }

    .group-2 .node {
      left: 1.25rem;
    }

    .decision {
      grid-column: 3 / 6;
      grid-row: 2;
      max-width: none;
      padding: 2.5rem 0 0 1.25rem;
    }

    .decision p {
      max-width: 52ch;
    }

    .scope {
      grid-column: 1 / 3;
      grid-row: 2;
      padding: 2.5rem 2.5rem 0 0;
    }

    /* With motion on, the route pins and travels sideways as the page scrolls. */
    :global(html.motion) .track {
      height: calc(100svh + var(--travel, 1400px) * 1.1);
      padding-block: 0;
    }

    :global(html.motion) .stage {
      position: sticky;
      top: var(--nav-h);
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: calc(100svh - var(--nav-h));
      overflow: hidden;
    }

    :global(html.motion) .rail {
      max-width: none;
      padding-inline: 0;
    }

    :global(html.motion) .route {
      --col: clamp(19rem, 25vw, 26rem);
      position: relative;
      display: flex;
      width: max-content;
      padding-inline: max(var(--gutter), calc((100vw - 86rem) / 2 + var(--gutter)));
      transform: translate3d(calc(var(--p, 0) * var(--travel, 0px) * -1), 0, 0);
      will-change: transform;
    }

    :global(html.motion) .group {
      flex: none;
      width: calc(var(--n) * var(--col));
    }

    :global(html.motion) .step {
      padding-right: 3rem;
    }

    :global(html.motion) .group-2 .step {
      padding-left: 0;
    }

    :global(html.motion) .group-2 .node {
      left: 0;
    }

    :global(html.motion) .decision,
    :global(html.motion) .scope {
      position: relative;
      flex: none;
      width: 22rem;
      padding: calc(var(--band) + 2.5rem + 3.5rem) 3rem 0 1.5rem;
    }

    /* The route carries on through the decision point. */
    :global(html.motion) .decision::before {
      content: '';
      position: absolute;
      top: calc(var(--band) + 2.5rem + var(--node-y));
      right: 0;
      left: 0;
      height: 1px;
      background: var(--color-slate);
      transform: scaleX(var(--draw, 1));
      transform-origin: left;
    }
  }
</style>

<script>
  import { clamp, motionOk, scrub } from '../scripts/motion';

  const track = document.querySelector<HTMLElement>('[data-route]');
  const route = track?.querySelector<HTMLElement>('.route');

  if (motionOk && track && route) {
    const wide = window.matchMedia('(min-width: 1024px)');
    const segments = [...route.querySelectorAll<HTMLElement>('.steps')];
    const decision = route.querySelector<HTMLElement>('.decision');
    const steps = [...route.querySelectorAll<HTMLElement>('.step')];
    let travel = 0;

    const size = () => {
      travel = wide.matches ? Math.max(0, route.scrollWidth - document.documentElement.clientWidth) : 0;
      track.style.setProperty('--travel', `${travel}px`);
      route.style.setProperty('--travel', `${travel}px`);
    };

    // Wide screens: the line is drawn up to a point just right of centre as the route travels past it.
    const update = (progress: number) => {
      if (!wide.matches) return;
      const head = progress * travel + document.documentElement.clientWidth * 0.62;
      const draw = (el: HTMLElement) => {
        const box = el.closest<HTMLElement>('.group') ?? el;
        el.style.setProperty('--draw', clamp((head - box.offsetLeft) / box.offsetWidth).toFixed(3));
      };
      segments.forEach(draw);
      if (decision) draw(decision);
      steps.forEach((step) => {
        const group = step.closest<HTMLElement>('.group');
        step.classList.toggle('on', head > (group?.offsetLeft ?? 0) + step.offsetLeft);
      });
    };

    scrub(track, { mode: 'pin', onUpdate: update });

    // Narrower screens: the route runs down the page and draws as each stage is scrolled through.
    segments.forEach((segment) => {
      const items = [...segment.querySelectorAll<HTMLElement>('.step')];
      scrub(segment, {
        mode: 'through',
        from: 0.72,
        to: 0.55,
        onUpdate: (progress) => {
          if (wide.matches) return;
          segment.style.setProperty('--draw', progress.toFixed(3));
          items.forEach((item, i) => item.classList.toggle('on', progress >= i / items.length));
        },
      });
    });

    size();
    window.addEventListener('resize', () => {
      size();
      update(Number(track.style.getPropertyValue('--p')) || 0);
    });
    document.fonts?.ready.then(size);
  }
</script>
