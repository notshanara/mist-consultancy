---
// Standard section layout: heading in the left column, content in the right.
interface Props {
  id: string;
  title: string;
  class?: string;
}
const { id, title, class: className } = Astro.props;
---

<section class:list={['section-y', className]} aria-labelledby={id}>
  <div class="wrap grid gap-y-8 lg:grid-cols-12 lg:gap-x-8">
    <div class="lg:col-span-4">
      <h2 id={id} class="text-heading">{title}</h2>
      <slot name="aside" />
    </div>
    <div class="lg:col-span-7 lg:col-start-6">
      <slot />
    </div>
  </div>
</section>
