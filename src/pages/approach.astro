---
import CtaBand from '../components/CtaBand.astro';
import MoatLayers from '../components/MoatLayers.astro';
import PageHero from '../components/PageHero.astro';
import ProblemInbox from '../components/ProblemInbox.astro';
import RouteDiagram from '../components/RouteDiagram.astro';
import Base from '../layouts/Base.astro';
---

<Base
  title="Our Approach | MIST Consultancy"
  description="How MIST works with clients in five steps, from discovery and assessment through to solution design, implementation and review."
>
  <PageHero
    title="Our approach"
    lead="How we work with clients, from the first conversation through to implementation."
  />

  <RouteDiagram />
  <ProblemInbox />
  <MoatLayers />

  <section id="founder-quote" class="section-y text-center" aria-labelledby="founder-quote-title">
    <div class="wrap">
      <h2 id="founder-quote-title" class="font-medium" data-reveal>From our founder</h2>
      <figure class="mt-8">
        <blockquote>
          <p class="mx-auto max-w-[34ch] text-heading" data-words>
            “We continually refine, develop and test our tool through relevant research, industrial insights and practical
            experience to ensure our methods remain effective, informed and consistent with the market’s climate.”
          </p>
        </blockquote>
        <figcaption class="mt-10 flex flex-col items-center gap-4 i-1" data-reveal>
          <span class="h-0.5 w-9 bg-blue" aria-hidden="true"></span>
          <span>
            <span class="block font-semibold">Shanan Mimana</span>
            <span class="block text-iron">Founder, MIST Consultancy</span>
          </span>
        </figcaption>
      </figure>
    </div>
  </section>

  <CtaBand />
</Base>
