---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import '@fontsource-variable/manrope/wght.css';
import '../styles/global.css';
import fontUrl from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import bootUrl from '../scripts/boot.js?url';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Small print shown above the footer. */
  footnote?: string;
}
const { title, description = site.description, footnote } = Astro.props;

// Gilroy is a paid font, so headings use it only once its licensed file is in public/fonts (see README).
const gilroy = existsSync(join(process.cwd(), 'public/fonts/gilroy-semibold.woff2'));

const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og.png', Astro.site);
const organisation = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.description,
  url: new URL('/', Astro.site).href,
  email: site.email.enquiries,
  telephone: site.phone.display,
  areaServed: 'United Kingdom',
};
---

<!doctype html>
<html lang="en-GB" data-review={import.meta.env.DEV ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    {gilroy && <link rel="preload" href="/fonts/gilroy-semibold.woff2" as="font" type="font/woff2" crossorigin />}
    {gilroy && <link rel="stylesheet" href="/fonts/gilroy.css" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Escaped so that a value containing a closing script tag can never end this block early. */}
    <script type="application/ld+json" set:html={JSON.stringify(organisation).replace(/</g, '\\u003c')} />
    <script is:inline src={bootUrl}></script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[70] focus:bg-white focus:px-4 focus:py-2 focus:text-carbon"
    >
      Skip to main content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer note={footnote} />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
